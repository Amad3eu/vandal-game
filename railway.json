{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build:leaderboard",
    "watchPatterns": ["server/leaderboard/**", "src/game/**", "src/data/**", "src/types/**", "package.json", "package-lock.json", "railway.json"]
  },
  "deploy": {
    "startCommand": "npm run start:leaderboard",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
