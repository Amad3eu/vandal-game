{
  "name": "dino-game",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "api": "node server/feedback-server.mjs",
    "dev": "vite",
    "dev:full": "sh -c 'npm run api & npm run dev'",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "build:server-engine": "esbuild src/game/server.ts --bundle --format=esm --platform=neutral --outfile=supabase/functions/_shared/vandal-engine.js",
    "build:leaderboard": "tsc --noEmit -p server/leaderboard && esbuild server/leaderboard/index.ts --bundle --platform=node --format=esm --packages=external --outfile=server/leaderboard/dist/index.mjs",
    "start:leaderboard": "node server/leaderboard/dist/index.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "type-check:tests": "tsc --noEmit -p tests"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "lucide-react": "^1.48.0",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.56.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^3.2.7"
  }
}
